# Copy to .env in the repository root. Never commit .env.
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# There is no setting for an Amazon password. Do not add one.

TRACKER_DB_PATH=./data/tracker.sqlite
TRACKER_SECRET_BACKEND=auto
TRACKER_SECRET_KEY=
TRACKER_SECRET_FILE=./data/secrets.bin
TRACKER_HOST=127.0.0.1
TRACKER_PORT=8787

# Optional read-only Keepa key when TRACKER_SECRET_BACKEND=env.
# TRACKER_SECRET_VALUE_KEEPA_API_KEY=
