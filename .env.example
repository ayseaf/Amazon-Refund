# Local service. Do not put an Amazon password or a Keepa key in this file.
# Enter a Keepa key in Settings. It is stored in the macOS Keychain, or in an
# encrypted file when Keychain is unavailable, and this version does not send it.
APT_HOST=127.0.0.1
APT_PORT=8787
# APT_DATA_DIR=/Users/you/.local/share/amazon-price-tracker
