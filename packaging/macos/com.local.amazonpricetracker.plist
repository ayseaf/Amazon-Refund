<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.amazonpricetracker</string>
  <key>Disabled</key>
  <true/>
  <key>RunAtLoad</key>
  <false/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <!--
    Not installed by the app. Copying this into ~/Library/LaunchAgents would
    start a check every hour once a later version has a permitted price source.
    Do that only on a Mac, and only when you want it.
  -->
</dict>
</plist>
